{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": [
      "jest",
      "node"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowJs": false,
    "moduleResolution": "nodenext",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
  },
  "include": [
    "src/scripts/**/*.ts",
    "src/__test__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "htdocs",
  ]
}

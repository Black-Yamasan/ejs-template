{
  "name": "ejs_template",
  "version": "15.0.1",
  "description": "ejsでのテンプレート",
  "main": "index.js",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "volta": {
    "node": "24.13.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/preset-env": "8.0.5",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "ejs": "3.1.10",
    "glob": "13.0.6",
    "jest": "30.5.1",
    "mini-css-extract-plugin": "2.10.2",
    "postcss-loader": "8.2.1",
    "sass": "1.104.1",
    "sass-loader": "17.0.1",
    "sass-migrator": "2.6.1",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0",
    "webpack-remove-empty-scripts": "1.1.1"
  },
  "scripts": {
    "build:dev": "NODE_ENV=development npx webpack --target node",
    "build:prod": "NODE_ENV=production npx webpack --target node",
    "start": "NODE_ENV=development npx webpack serve --target web",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Black-Yamasan/ejs-template.git"
  },
  "keywords": [
    "npm",
    "yarn",
    "install",
    "--save-dev",
    "webpack"
  ],
  "author": "Black-Yamasan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Black-Yamasan/ejs-template/issues"
  },
  "homepage": "https://github.com/Black-Yamasan/ejs-template#readme",
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.js$": "<rootDir>/node_modules/babel-jest"
    },
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.{js}",
      "!**/node_modules/**"
    ]
  }
}

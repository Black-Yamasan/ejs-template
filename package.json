{
  "name": "ejs_template",
  "version": "17.0.0",
  "description": "ejsでのテンプレート",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.13.0",
    "pnpm": "12.5.1"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.js$": "<rootDir>/node_modules/babel-jest"
    },
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.{js}",
      "!**/node_modules/**"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "ejs": "6.0.1",
    "esbuild-loader": "4.5.0",
    "eslint": "10.11.0",
    "glob": "13.0.6",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "mini-css-extract-plugin": "2.10.2",
    "prettier": "3.9.9",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "7.0.2",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0",
    "webpack-remove-empty-scripts": "1.1.1"
  },
  "scripts": {
    "build:dev": "NODE_ENV=development npx webpack --target node",
    "build:prod": "NODE_ENV=production npx webpack --target node",
    "start": "NODE_ENV=development npx webpack serve --target web",
    "test": "jest",
    "lint": "eslint",
    "prettier:check": "prettier -c ./src/**/*",
    "prettier:write": "prettier --write ./src/**/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Black-Yamasan/ejs-template.git"
  },
  "keywords": [
    "pnpm",
    "install",
    "--save-dev",
    "webpack"
  ],
  "author": "Black-Yamasan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Black-Yamasan/ejs-template/issues"
  },
  "homepage": "https://github.com/Black-Yamasan/ejs-template#readme"
}
